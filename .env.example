# ---------------------------------------------------------------------------
# Frog — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# TMDB API read key. Free: https://www.themoviedb.org/settings/api
# Works with either the v3 API key (32 hex chars) or a v4 read access token (JWT).
TMDB_API_KEY=

# Where SQLite lives. In Docker this is inside the mounted volume.
DATABASE_URL=sqlite:./data/frog.db?mode=rwc

# Bind address for the HTTP server.
FROG_BIND=0.0.0.0:8080

# Directory holding the built SvelteKit app (server falls back to SPA index.html).
FROG_STATIC_DIR=./static

# Region used for "where to watch" providers and release dates.
FROG_REGION=BE
FROG_LANGUAGE=en-US

# First-run bootstrap. If no account exists yet and both are set, this account
# is created at startup. Leave blank to create the account from the setup screen.
FROG_ADMIN_USERNAME=
FROG_ADMIN_PASSWORD=

# Set to 1 when serving over HTTPS so the session cookie gets the Secure flag.
# Tailscale Serve terminates TLS for you, so set this to 1 in that setup.
FROG_SECURE_COOKIES=0

# Session lifetime in days.
FROG_SESSION_DAYS=90

# New-episode notifications go out from this hour (0-23, server time) on the
# day an episode airs.
FROG_NOTIFY_HOUR=18

# AniList sync. Register a client at https://anilist.co/settings/developer
# with the redirect URL below (it must match exactly), then fill in all three.
# Leave them empty and AniList simply does not appear in Settings.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=https://your-frog.example/api/anilist/callback

# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=frog=info,tower_http=warn
