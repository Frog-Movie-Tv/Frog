{
  "name": "frog-extension",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "description": "Logs what you watch on any site to your Frog.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "e2e": "playwright test",
    "videos": "node scripts/make-videos.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "~1.64.1",
    "@types/node": "^24.19.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
