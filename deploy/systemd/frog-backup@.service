[Unit]
Description=Back up the %i instance of Frog
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/frog/deploy/backup.sh %i nightly
# A copy of the whole database, its check, and the compaction without the
# caches: about 14 minutes at 945 MB on the Always Free machine.
TimeoutStartSec=3600
