# One Frog instance. Copy to /opt/frog/<instance>/.env and chmod 600.
# This file holds the only secret on the machine.

# Which compose project this is. Must differ between the two instances, since
# it names the container and the volume.
COMPOSE_PROJECT_NAME=frog-production

# Which image tag to follow.
#   latest  the newest tagged release   (production)
#   main    whatever is on main          (staging)
IMAGE_TAG=latest

# Free, from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# So FROG_NOTIFY_HOUR means the hour you actually live in.
TZ=Europe/Brussels

# Region used for "where to watch" and release dates.
FROG_REGION=BE
FROG_LANGUAGE=en-US

# New-episode notifications go out from this hour, local time.
FROG_NOTIFY_HOUR=18

# AniList sync (optional). A client from https://anilist.co/settings/developer
# whose redirect URL is exactly ANILIST_REDIRECT_URI. All three, or none.
# Optional: scores from IMDb, Rotten Tomatoes and Metacritic. A free key from
# https://mdblist.com/preferences.
MDBLIST_API_KEY=
# Optional: title logos TMDB lacks. A free personal key from
# https://fanart.tv/get-an-api-key/.
FANART_API_KEY=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=
# Minutes between looks at each connected AniList list (1-60, default 3).
# ANILIST_SYNC_MINUTES=3
# Most the picture cache may hold, in MB (64 at least, default 512). Pictures
# not looked at for longest go first; they are fetched again when needed.
# FROG_IMAGE_CACHE_MB=512

# How long "keep me signed in" lasts.
FROG_SESSION_DAYS=90

RUST_LOG=frog=info,tower_http=warn
