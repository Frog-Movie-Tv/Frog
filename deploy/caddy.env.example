# Copy to /opt/frog/caddy/.env and chmod 600.

# The two DuckDNS names, without a scheme.
PRODUCTION_DOMAIN=frogtv.duckdns.org
STAGING_DOMAIN=frogtv-staging.duckdns.org

# Let's Encrypt emails this address before a certificate expires.
ACME_EMAIL=

# While testing, point at the staging certificate authority so a few failed
# attempts cannot use up the real rate limit for a week. Comment it out again
# once the site answers over HTTPS, then: docker compose up -d --force-recreate
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
