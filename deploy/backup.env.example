# Copy to /opt/frog/backup.env and chmod 600.

# The age *public* key. The server encrypts with it and cannot read the
# backups back, which is the point: a machine that is compromised does not
# hand over thirty days of databases. Generate the pair on your own computer:
#
#   age-keygen -o frog-backup.key
#
# Keep frog-backup.key somewhere safe and off this machine. Paste the line it
# prints that starts with age1... here.
AGE_RECIPIENT=

# A clone of the private backup repository, with a deploy key that can push.
# Leave blank to keep local backups only.
BACKUP_REPO_DIR=/opt/frog/backup-repo
